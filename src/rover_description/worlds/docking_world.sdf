<?xml version="1.0" ?>
<sdf version="1.10">
  <world name="docking_world">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry></collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="obstacle_box">
      <pose>1.0 1.0 0.25 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="col"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material><ambient>0.8 0.2 0.2 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="obstacle_cylinder">
      <pose>1.5 -1.2 0.3 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.2</radius><length>0.6</length></cylinder></geometry></collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.2</radius><length>0.6</length></cylinder></geometry>
          <material><ambient>0.2 0.8 0.2 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="docking_station">
      <pose>2.5 0 0 0 0 3.14159</pose>
      <static>true</static>
      <link name="dock_link">
        <visual name="back_wall"><pose>0 0 0.15 0 0 0</pose><geometry><box><size>0.1 0.4 0.3</size></box></geometry><material><ambient>0.2 0.2 0.8 1</ambient></material></visual>
        <collision name="back_wall_col"><pose>0 0 0.15 0 0 0</pose><geometry><box><size>0.1 0.4 0.3</size></box></geometry></collision>
        
        <visual name="left_wall"><pose>0.15 0.15 0.05 0 0 0</pose><geometry><box><size>0.3 0.1 0.1</size></box></geometry><material><ambient>0.2 0.2 0.8 1</ambient></material></visual>
        <collision name="left_wall_col"><pose>0.15 0.15 0.05 0 0 0</pose><geometry><box><size>0.3 0.1 0.1</size></box></geometry></collision>
        
        <visual name="right_wall"><pose>0.15 -0.15 0.05 0 0 0</pose><geometry><box><size>0.3 0.1 0.1</size></box></geometry><material><ambient>0.2 0.2 0.8 1</ambient></material></visual>
        <collision name="right_wall_col"><pose>0.15 -0.15 0.05 0 0 0</pose><geometry><box><size>0.3 0.1 0.1</size></box></geometry></collision>

        <visual name="aruco_tag_vis">
          <pose>0.051 0 0.15 0 0 0</pose> 
          <geometry><box><size>0.001 0.15 0.15</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <pbr>
              <metal>
                <albedo_map>/home/ananya/Yellow_Rover/src/rover_description/model/aruco_marker.png</albedo_map>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
